# Service display name
NAME=

# Semver or build version
VERSION=

# Bind host
HOST=

# Listen port
PORT=

# PostgreSQL connection string; required for project state
DATABASE_URL=

# Shared secret used to verify HS256 access tokens; use at least 32 bytes
JWT_SECRET=

# Expected access-token issuer
JWT_ISSUER=

# Expected access-token audience
JWT_AUDIENCE=
