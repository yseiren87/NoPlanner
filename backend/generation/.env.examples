# Service display name
NAME=

# Semver or build version
VERSION=

# Bind host
HOST=

# Listen port
PORT=

# Local command used only by platform scripts/run.* (.env.local-dev)
RUN_COMMAND=

# PostgreSQL connection string; required for generated result state
DATABASE_URL=

# Redis connection string; missing value blocks asynchronous generation only
REDIS_URL=

# Intelligence service gRPC address used for generated planning and design
INTELLIGENCE_GRPC_ADDRESS=

# Evaluation service gRPC address used to evaluate generated plans with the same engine
EVALUATION_GRPC_ADDRESS=

# Path-list of local roots from which authenticated projects may analyze Git repositories
REPOSITORY_ALLOWED_ROOTS=

# Google Drive connector endpoint
DRIVE_CONNECTOR_URL=

# Google Drive connector secret
DRIVE_CONNECTOR_KEY=

# Notion connector endpoint
NOTION_CONNECTOR_URL=

# Notion connector secret
NOTION_CONNECTOR_KEY=

# Confluence connector endpoint
CONFLUENCE_CONNECTOR_URL=

# Confluence connector secret
CONFLUENCE_CONNECTOR_KEY=

# GitHub connector endpoint
GITHUB_CONNECTOR_URL=

# GitHub connector secret
GITHUB_CONNECTOR_KEY=

# Jira connector endpoint
JIRA_CONNECTOR_URL=

# Jira connector secret
JIRA_CONNECTOR_KEY=

# Slack connector endpoint
SLACK_CONNECTOR_URL=

# Slack connector secret
SLACK_CONNECTOR_KEY=

# Shared secret authenticating service-to-service gRPC calls
INTERNAL_SERVICE_TOKEN=
