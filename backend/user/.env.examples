# Service display name
NAME=

# Semver or build version
VERSION=

# Bind host
HOST=

# Listen port
PORT=

# Local command used only by platform scripts/run.* (.env.local-dev)
RUN_COMMAND=

# PostgreSQL connection string; required for persisted user and auth state
DATABASE_URL=

# Google OAuth client ID; missing value disables login
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth client secret; missing value disables login
GOOGLE_OAUTH_CLIENT_SECRET=

# Google OAuth callback URL paired with the configured client
GOOGLE_OAUTH_REDIRECT_URL=

# JWT signing secret; missing value disables token issuance
JWT_SECRET=

# JWT issuer claim
JWT_ISSUER=

# JWT audience claim
JWT_AUDIENCE=

# JWT lifetime such as 1h
JWT_TTL=
