# Service display name
NAME=

# Semver or build version
VERSION=

# Bind host
HOST=

# Listen port
PORT=

# Local command used only by platform scripts/run.* (.env.local-dev)
RUN_COMMAND=

# LLM provider: claude, grok, or openai
LLM_PROVIDER=

# Provider-specific LLM model identifier
LLM_MODEL=

# API key for the selected LLM provider
LLM_KEY=

# Gemini API key used for Google Search grounding
GEMINI_API_KEY=

# Gemini model supporting Google Search grounding
GOOGLE_SEARCH_MODEL=

# Shared secret authenticating service-to-service gRPC calls
INTERNAL_SERVICE_TOKEN=
