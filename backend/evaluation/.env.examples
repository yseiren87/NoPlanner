# Service display name
NAME=

# Semver or build version
VERSION=

# Bind host
HOST=

# Listen port
PORT=

# Local command used only by platform scripts/run.* (.env.local-dev)
RUN_COMMAND=

# PostgreSQL connection string; required for evaluation state
DATABASE_URL=

# Redis connection string; missing value blocks asynchronous evaluation only
REDIS_URL=

# Intelligence service gRPC address used for LLM evaluation
INTELLIGENCE_GRPC_ADDRESS=

# Shared secret authenticating service-to-service gRPC calls
INTERNAL_SERVICE_TOKEN=
