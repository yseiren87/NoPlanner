NAME=gateway
VERSION=0.1.0
HOST=127.0.0.1
PORT=8080

# Shared JWT signing secret used to protect the web API
JWT_SECRET=

# Expected JWT issuer
JWT_ISSUER=

# Expected JWT audience
JWT_AUDIENCE=

# Redis connection used for durable asynchronous evaluation jobs
REDIS_URL=

# User service gRPC address
USER_GRPC_ADDRESS=

# Project service gRPC address
PROJECT_GRPC_ADDRESS=

# Document service gRPC address
DOCUMENT_GRPC_ADDRESS=

# Research service gRPC address
RESEARCH_GRPC_ADDRESS=

# Evaluation service gRPC address
EVALUATION_GRPC_ADDRESS=

# Generation service gRPC address
GENERATION_GRPC_ADDRESS=

# Shared secret authenticating service-to-service gRPC calls
INTERNAL_SERVICE_TOKEN=
