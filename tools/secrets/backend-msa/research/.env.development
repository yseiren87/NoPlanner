NAME=research
VERSION=0.1.0
HOST=0.0.0.0
PORT=8080

# PostgreSQL connection string; required for research state
DATABASE_URL=

# Redis connection string; missing value blocks asynchronous research only
REDIS_URL=

# Intelligence service gRPC address; missing value limits evaluation to internal checks
INTELLIGENCE_GRPC_ADDRESS=

# Estimated cost for one Google search request; used to enforce per-research cost limits
GOOGLE_SEARCH_COST_PER_QUERY=

# Shared secret authenticating service-to-service gRPC calls
INTERNAL_SERVICE_TOKEN=
